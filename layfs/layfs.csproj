<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>layfs</AssemblyName>
    <RootNamespace>layfs</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Platforms>AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- WinFsp ships the managed layer as winfsp-msil.dll (a .NET Framework assembly).
       Override with -p:WinFspDir=... when WinFsp is installed elsewhere. -->
  <PropertyGroup>
    <WinFspDir Condition="'$(WinFspDir)' == '' and Exists('$(ProgramFiles)\WinFsp\bin\winfsp-msil.dll')">$(ProgramFiles)\WinFsp\bin\</WinFspDir>
    <WinFspDir Condition="'$(WinFspDir)' == '' and Exists('$(MSBuildProgramFiles32)\WinFsp\bin\winfsp-msil.dll')">$(MSBuildProgramFiles32)\WinFsp\bin\</WinFspDir>
    <WinFspDir Condition="'$(WinFspDir)' == ''">$(ProgramFiles)\WinFsp\bin\</WinFspDir>
  </PropertyGroup>

  <Target Name="VerifyWinFsp" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WinFspDir)winfsp-msil.dll')"
           Text="WinFsp was not found at '$(WinFspDir)'. Install it from https://winfsp.dev or pass -p:WinFspDir=&quot;C:\path\to\WinFsp\bin\&quot;." />
  </Target>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspDir)winfsp-msil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
